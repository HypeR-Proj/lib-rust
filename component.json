  "cargo_context": {
    "hyper-os/Cargo.toml": {
      "workspace": null,
      "membership": "..",
      "dependency_paths": {
        "/dependencies/hyper-abi": "sdk/abi",
        "/dependencies/hyper-sys": "stdlib/rust/hyper-sys"
      },
      "inherited_dependencies": {
        "/dependencies/hyper-abi": {
          "workspace": true
        }
      }
    },
    "hyper-rt/Cargo.toml": {
      "workspace": null,
      "membership": "..",
      "dependency_paths": {
        "/dependencies/hyper-abi": "sdk/abi",
        "/dependencies/hyper-os": "stdlib/rust/hyper-os",
        "/dependencies/hyper-sys": "stdlib/rust/hyper-sys"
      },
      "inherited_dependencies": {
        "/dependencies/hyper-abi": {
          "workspace": true
        }
      }
    },
    "hyper-sys/Cargo.toml": {
      "workspace": null,
      "membership": "..",
      "dependency_paths": {
        "/dependencies/hyper-abi": "sdk/abi"
      },
      "inherited_dependencies": {
        "/dependencies/hyper-abi": {
          "workspace": true
        }
      }
    },
    "Cargo.toml": {
      "workspace": {
        "resolver": "3",
        "members": [
          "hyper-filesystem",
          "hyper-os",
          "hyper-rt",
          "hyper-sys"
        ],
        "package": {
          "version": "0.0.0",
          "edition": "2024",
          "license": "Apache-2.0",
          "repository": "https://github.com/roolrz/HypeR",
          "publish": false
        },
        "dependencies": {
          "hyper-abi": {
            "path": "../../sdk/abi"
          }
        },
        "lints": {
          "clippy": {
            "doc_markdown": "deny",
            "empty_docs": "deny",
            "expect_used": "deny",
            "panic": "deny",
            "todo": "deny",
            "undocumented_unsafe_blocks": "deny",
            "unimplemented": "deny",
            "unreachable": "deny",
            "unwrap_used": "deny",
            "missing_safety_doc": "deny"
          },
          "rust": {
            "unsafe_op_in_unsafe_fn": "deny",
            "unexpected_cfgs": {
              "level": "warn",
              "check-cfg": [
                "cfg(target_os, values(\"hyper\"))"
              ]
            }
          }
        }
      },
      "membership": null,
      "dependency_paths": {},
      "inherited_dependencies": {},
      "extra_workspace_members": [
        "hyper-filesystem"
      ],
      "workspace_dependency_paths": {
        "hyper-abi": "sdk/abi"
      }
    }
  }
